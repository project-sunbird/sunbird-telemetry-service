{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "checkJs": false,
    "typeRoots": ["./node_modules/@types", "./types"],
    "types": ["mocha", "node"]
  },
  "include": ["types/**/*", "test/**/*.ts"]
}
